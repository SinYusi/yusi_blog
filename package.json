{
  "name": "yusi_blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.mts && tsx scripts/seed.mts --preview-only && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/db-check.mts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/static-renderer": "3.31.4",
    "drizzle-orm": "^0.45.3",
    "hast-util-to-string": "^3.0.1",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@next/env": "16.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
