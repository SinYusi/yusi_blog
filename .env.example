# 로컬 개발용 환경 변수 예시. 이 파일을 .env.local로 복사해 값을 채웁니다. (.env.local은 커밋하지 않습니다)
# Vercel에서 Neon을 연결하면 배포 환경에는 같은 이름의 변수가 자동으로 설정됩니다.
# 로컬에서는 운영(main)이 아닌 Neon의 dev 브랜치 연결 문자열을 씁니다 (ADR-0005).

# Neon 연결 문자열 (커넥션 풀러 경유). 앱의 DB 쿼리에 사용합니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Neon 직접 연결 문자열 (선택). drizzle-kit 마이그레이션에 사용하며, 없으면 DATABASE_URL을 씁니다.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# 로컬 시드(pnpm db:seed)를 허용할 Neon 엔드포인트 ID (dev 브랜치). pnpm db:check의 "앱 쿼리 대상"에서 확인합니다.
# 이 값과 DATABASE_URL의 엔드포인트가 다르면 시드가 실행되지 않습니다 (운영 DB 덮어쓰기 방지).
SEED_ALLOWED_ENDPOINT=ep-xxxx-xxxxxxxx

# 사이트 대표 주소 (선택). canonical, sitemap, RSS의 절대 URL 기준입니다. 커스텀 도메인을 연결하면 설정하고,
# 없으면 Vercel 운영 도메인(VERCEL_PROJECT_PRODUCTION_URL), 로컬에서는 http://localhost:3000을 씁니다.
# NEXT_PUBLIC_SITE_URL=https://example.com
